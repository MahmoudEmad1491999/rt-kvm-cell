# Cell-host (L1 VM): x86_64, glibc, Linux 6.18 LTS, minimal rootfs, serial console.
# Runs as a KVM guest on the laptop and hosts three nested L2 KVM guests.

BR2_x86_64=y

# Toolchain: internal, glibc (explicit; needed for C11 RT apps in later phases)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# System identity & networking
BR2_SYSTEM_HOSTNAME="cellhost"
BR2_SYSTEM_DHCP="eth0"

# Serial console (headless VM; QEMU -nographic / -serial stdio)
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# Linux 6.18.7 — latest point release on the 6.18 stable branch
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RT_KVM_CELL_PATH)/board/cellhost/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Root filesystem: ext2/4 image; no tar archive needed
BR2_TARGET_ROOTFS_EXT2=y
# BR2_TARGET_ROOTFS_TAR is not set
