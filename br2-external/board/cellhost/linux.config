# Kernel config for the cell host (L1 VM).
# Applied as a custom config; Buildroot runs `make olddefconfig` to fill in
# defaults for any symbol not listed here.
#
# Dual role: (a) KVM *guest* of the laptop, (b) KVM *host* for three L2 VMs.

# --- CPU ---
CONFIG_SMP=y

# --- KVM guest (we run AS a virtio/KVM VM) ---
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# --- KVM host (we run nested L2 VMs) ---
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=y

# --- Modules ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- Networking ---
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_WIRELESS is not set
CONFIG_NETDEVICES=y
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y

# --- PCI / bus ---
CONFIG_PCI=y

# --- Device management ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Virtio (cellhost IS a virtio VM) ---
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_SD=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_VIRTIO_MMIO=y

# --- Serial console (ttyS0 → QEMU -nographic / -serial stdio) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- ATA (IDE/AHCI fallback, keeps image compatible with -M pc) ---
CONFIG_ATA=y
CONFIG_ATA_PIIX=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# --- IPC / cgroups (needed by QEMU and resource isolation) ---
CONFIG_SYSVIPC=y
CONFIG_CGROUPS=y

# --- Hugepages (RT tuning, Phase 4) ---
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# --- Stack unwinder ---
CONFIG_UNWINDER_FRAME_POINTER=y
